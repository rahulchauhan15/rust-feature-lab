# Cargo Feature Mock POC - Copy to .env and customize
# For local dev/prod setup

PORT=3000

# Live services (required without --features mock)
OPENWEATHER_API_KEY=your_openweather_api_key_here
S3_BUCKET=your-s3-bucket-name

# Mock overrides (set to 1 to force mock even with live feature)
# MOCK_WEATHER=1
# MOCK_S3=1

# Example usage:
# cp .env.example .env
# cargo run --features mock

